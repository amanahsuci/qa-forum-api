generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String          @id @default(cuid())
  username          String          @unique
  email             String          @unique
  passwordHash      String
  createdAt         DateTime        @default(now())
  threads           Thread[]
}

model Thread {
  id                String          @id @default(cuid())
  title             String
  content           String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  userId            String
  user              User            @relation(fields: [userId], references: [id])
}